# ──────────────────────────────────────────────────
#   ChessCode — Environment Variables
#   Copy to .env and fill in your keys
# ──────────────────────────────────────────────────

# Required — AI brain
ANTHROPIC_API_KEY=sk-ant-api03-...

# Required — game sourcing
LICHESS_TOKEN=lip_...

# Optional — premium voice (free gTTS used if not set)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_EN=21m00Tcm4TlvDq8ikWAM   # Rachel (English)
ELEVENLABS_VOICE_HI=                         # Set a Hindi voice ID

# Optional — AI thumbnails (PIL fallback if not set)
LEONARDO_API_KEY=...
OPENAI_API_KEY=sk-...  # For gpt-image-1 thumbnail generation

# Optional — Notion content-calendar sync (publish_and_track)
NOTION_API_KEY=

# YouTube
YT_PRIVACY=private          # private | unlisted | public
YT_PLAYLIST_EN=             # YouTube playlist ID for English
YT_PLAYLIST_HI=             # YouTube playlist ID for Hindi

# Language settings
PUBLISH_EN=true
PUBLISH_HI=true

# Schedule
VIDEOS_PER_WEEK=2
UPLOAD_TIME_IST=09:00

# Video quality
RESOLUTION=1920x1080
FPS=24
VIDEO_BITRATE=8000k
AUDIO_BITRATE=192k
ENCODING_PRESET=medium      # ultrafast | fast | medium | slow
BOARD_THEME=classic         # classic | blue | green | dark_mode

# Stockfish
STOCKFISH_PATH=stockfish    # or /usr/bin/stockfish
STOCKFISH_DEPTH=18
STOCKFISH_THREADS=4

# LLM Backend (toggleable — claude uses Anthropic API, ollama uses local model)
LLM_BACKEND=claude              # claude | ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# TTS
TTS_BACKEND=gtts            # gtts | elevenlabs | kokoro

# Kokoro TTS voices (used when TTS_BACKEND=kokoro)
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_HI=hf_alpha

# Paths
OUTPUT_DIR=output
DB_PATH=chesscode.db
PGN_CACHE=output/pgn_cache

# Stats intro (animated card at video start — ratings/opening stats/channel stats)
STATS_INTRO_ENABLED=true
STATS_INTRO_DURATION=5.5

# YouTube Data API (channel stats ribbon in stats intro — separate from the
# OAuth client used for uploads; this is a plain API key)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
