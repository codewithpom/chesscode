{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "video_id": {
      "type": "string",
      "pattern": "^cc-\\d{4}-\\d{4}-(en|hi)$"
    },
    "pair_id": {
      "type": "string",
      "pattern": "^cc-\\d{4}-\\d{4}$"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "hi"
      ]
    },
    "template": {
      "type": "string",
      "enum": [
        "studio",
        "shorts",
        "editorial",
        "arena"
      ]
    },
    "series": {
      "type": "string",
      "enum": [
        "legendary_games",
        "indian_chess_heroes",
        "opening_explained",
        "blunder_hall_of_fame"
      ]
    },
    "board": {
      "type": "object",
      "properties": {
        "orientation": {
          "type": "string",
          "enum": [
            "white",
            "black"
          ]
        },
        "theme": {
          "type": "string",
          "enum": [
            "bone_slate",
            "walnut",
            "cool_grey",
            "warm_sand"
          ]
        }
      },
      "required": [
        "orientation",
        "theme"
      ]
    },
    "format": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "game": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "lichess",
            "local"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "white": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "rating": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "country": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "fact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "name",
            "rating",
            "title",
            "country",
            "fact"
          ]
        },
        "black": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "rating": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "country": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "fact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "name",
            "rating",
            "title",
            "country",
            "fact"
          ]
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "enum": [
            "1-0",
            "0-1",
            "1/2-1/2"
          ]
        },
        "eco": {
          "type": "string",
          "pattern": "^[A-E]\\d{2}$"
        },
        "opening": {
          "type": "string",
          "minLength": 1
        },
        "pgn": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "source_id",
        "white",
        "black",
        "event",
        "date",
        "result",
        "eco",
        "opening",
        "pgn"
      ]
    },
    "plies": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ply": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "san": {
            "type": "string",
            "minLength": 1
          },
          "uci": {
            "type": "string",
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
          },
          "fen_after": {
            "type": "string",
            "minLength": 1
          },
          "eval": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "cp": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "mate": {
                    "type": "null"
                  }
                },
                "required": [
                  "cp",
                  "mate"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "cp": {
                    "type": "null"
                  },
                  "mate": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "cp",
                  "mate"
                ]
              }
            ]
          },
          "best_uci": {
            "type": "string",
            "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
          },
          "class": {
            "type": "string",
            "enum": [
              "book",
              "best",
              "excellent",
              "good",
              "inaccuracy",
              "mistake",
              "blunder",
              "brilliant",
              "missed_win"
            ]
          },
          "clock_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "show_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "arrows": {
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^[a-h][1-8]$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[a-h][1-8]$"
                },
                "color": {
                  "type": "string",
                  "enum": [
                    "best",
                    "threat",
                    "missed"
                  ]
                }
              },
              "required": [
                "from",
                "to",
                "color"
              ]
            }
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "square": {
                  "type": "string",
                  "pattern": "^[a-h][1-8]$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "last_move",
                    "check"
                  ]
                }
              },
              "required": [
                "square",
                "kind"
              ]
            }
          }
        },
        "required": [
          "ply",
          "san",
          "uci",
          "fen_after",
          "eval",
          "best_uci",
          "class",
          "clock_ms",
          "show_at_ms",
          "arrows",
          "highlights"
        ]
      }
    },
    "narration": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "cold_open",
              "title",
              "player_intro",
              "ply",
              "chapter",
              "key_moment",
              "verdict",
              "outro"
            ]
          },
          "ply": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "audio": {
            "type": "string",
            "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\.\\.).+$"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "duration_ms": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "words": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "string",
                  "minLength": 1
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "w",
                "start_ms",
                "end_ms"
              ]
            }
          }
        },
        "required": [
          "segment_id",
          "kind",
          "ply",
          "text",
          "audio",
          "start_ms",
          "duration_ms",
          "words"
        ]
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "blunder",
              "mistake",
              "brilliant",
              "missed_win",
              "comeback",
              "long_think",
              "time_scramble",
              "king_walk",
              "promotion",
              "checkmate",
              "resign",
              "opening_exit"
            ]
          },
          "ply": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "intensity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "mascot": {
            "type": "object",
            "properties": {
              "pose": {
                "type": "string",
                "enum": [
                  "idle",
                  "wave",
                  "thinking",
                  "side_eye",
                  "facepalm",
                  "faint",
                  "slow_clap",
                  "screaming",
                  "shocked",
                  "party",
                  "checks_watch",
                  "sweating",
                  "binoculars",
                  "jealous",
                  "mic_drop",
                  "bow",
                  "point"
                ]
              },
              "line": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "pose",
              "line"
            ]
          },
          "fx": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "board_shake",
                "red_flash",
                "replay_move",
                "move_underline",
                "gold_glint",
                "stamp_brilliant",
                "ghost_arrow",
                "eval_whip",
                "clock_pulse",
                "clock_red",
                "king_trail",
                "crown_sparkle",
                "freeze_frame",
                "out_of_theory_label"
              ]
            }
          },
          "sfx": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "beat_id",
          "type",
          "ply",
          "at_ms",
          "intensity",
          "mascot",
          "fx",
          "sfx"
        ]
      }
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "title",
          "start_ms"
        ]
      }
    },
    "cold_open": {
      "type": "object",
      "properties": {
        "ply_from": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "ply_to": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        }
      },
      "required": [
        "ply_from",
        "ply_to",
        "hook"
      ]
    },
    "key_moments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "ply": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "duration_ms": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "line": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
            }
          }
        },
        "required": [
          "beat_id",
          "ply",
          "start_ms",
          "duration_ms",
          "label",
          "line"
        ]
      }
    },
    "verdict": {
      "type": "object",
      "properties": {
        "turning_point_ply": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "accuracy": {
          "type": "object",
          "properties": {
            "white": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "black": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "white",
            "black"
          ]
        }
      },
      "required": [
        "turning_point_ply",
        "accuracy"
      ]
    },
    "thumbnail": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "pattern": "^\\S+(?: \\S+){0,3}$"
        },
        "ply": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "crop_origin": {
          "type": "string",
          "pattern": "^[a-e][1-5]$"
        },
        "pose": {
          "type": "string",
          "enum": [
            "idle",
            "wave",
            "thinking",
            "side_eye",
            "facepalm",
            "faint",
            "slow_clap",
            "screaming",
            "shocked",
            "party",
            "checks_watch",
            "sweating",
            "binoculars",
            "jealous",
            "mic_drop",
            "bow",
            "point"
          ]
        }
      },
      "required": [
        "text",
        "ply",
        "crop_origin",
        "pose"
      ]
    },
    "music": {
      "type": "object",
      "properties": {
        "track": {
          "type": "string",
          "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\.\\.).+$"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duck_under_voice": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "track",
        "volume",
        "duck_under_voice"
      ]
    },
    "youtube": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "playlist": {
          "type": "string",
          "minLength": 1
        },
        "publish_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "default_language": {
          "type": "string",
          "enum": [
            "en",
            "hi"
          ]
        },
        "made_for_kids": {
          "type": "boolean",
          "const": false
        },
        "contains_synthetic_media": {
          "type": "boolean"
        },
        "thumbnail": {
          "type": "string",
          "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\.\\.).+$"
        }
      },
      "required": [
        "title",
        "description",
        "tags",
        "playlist",
        "publish_at",
        "default_language",
        "made_for_kids",
        "contains_synthetic_media",
        "thumbnail"
      ]
    }
  },
  "required": [
    "spec_version",
    "video_id",
    "pair_id",
    "language",
    "template",
    "series",
    "board",
    "format",
    "duration_ms",
    "game",
    "plies",
    "narration",
    "beats",
    "chapters",
    "cold_open",
    "key_moments",
    "verdict",
    "thumbnail",
    "music",
    "youtube"
  ]
}
